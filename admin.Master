<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="admin.master.cs" Inherits="Maintenance_System.admin" %>

<html>
<head runat="server">
        <title>Admin Dashboard</title>
        <meta charset="UTF-8">
        <script src="https://kit.fontawesome.com/b99e675b6e.js"></script>
        <link rel ="shortcut icon" href="mhi.ico" />
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
        <style>
            *{
              margin: 0;
              padding: 0;
              box-sizing: border-box;
              list-style: none;
              text-decoration: none;
              font-family: 'Montserrat';
            }

        body{
          background: #d5e3f7;
          font-size: 14px;
          letter-spacing: 1px;
        }

        .wrapper{
          display: flex;
          width: 100%;
        }

        .sidebar{
          position: relative;
        }

        .sidebar .bg_shadow{
          width: 100%;
          height: 100%;
          position: fixed;
          top: 0;
          left: 0;
          background: #000;
          z-index: 998;
          opacity: 0;
          visibility: hidden;
          transition: all 0.3s ease;
        }

        .sidebar_inner {
          width: 300px;
          position: fixed;
          top: 0;
          left: 0;
          height: 100vh;
          background: rgb(2,77,135);
          z-index: 999;
          transition: all 0.3s ease;
        }

        .main_container {
          margin-left: 300px;
          width: calc(100% - 250px);
           transition: all 0.3s ease;
        }

        .sidebar_inner .profile_info {
          padding: 20px;
          text-align: center;
        }

        .sidebar_inner .profile_info .profile_img {
          width: 100px;
          margin: 0 auto 5px;
        }

        .sidebar_inner .profile_info .profile_img img {
          width: 100%;
          display: block;
        }

        .sidebar_inner .profile_info .profile_data .name {
          font-size: 18px;
          color: #fff;
          margin-bottom: 5px;
          font-family: 'Trade Winds';
        }

        .sidebar_inner .profile_info .profile_data span {
          color: #fdfdfd;
        }

        .sidebar_inner .siderbar_menu{
              height: 500px;
            overflow: auto;
        }

        .sidebar_inner .siderbar_menu > li > a {
          padding: 12px 20px;
          display: flex;
          align-items: center;
          position: relative;
          margin-bottom: 1px;
          color: #ccd6fa;
  
        }

        .sidebar_inner .siderbar_menu > li > a .icon {
          font-size: 25px;
          margin-right: 15px;
        }

        .sidebar_inner .siderbar_menu > li.active > a,
        .sidebar_inner .siderbar_menu > li > a:hover{
          background:  rgb(2,77,135)  ;
          color: #fff;
          text-decoration: none !important;
        }

        .sidebar_inner .siderbar_menu > li > a .arrow{
          position: absolute;
          top: 20px;
          right: 20px;
          transition: all 0.3s ease;
        }

        .sidebar .logout_btn a{
          position: absolute;
          bottom: 20px;
          left: 20px;
          width: 210px;
          border: 1px solid ;
          background:white;
          color: rgb(2,77,135);
          border-radius: 5px;
          font-weight: 600;
          padding: 10px;
          text-align: center;
          transition: all 0.3s ease;
        }

        .sidebar .logout_btn a:hover {
            background: rgb(2,77,135);
            color: white;
            text-decoration: none;
        }

        .sidebar_inner .close{
            position: absolute;
            top: 5px;
            right: 15px;
            font-size: 25px;
            color: #fff;
          cursor: pointer;
          display: block;
        }

        .sidebar_inner .close:hover,
        .navbar .hamburger:hover{
          opacity: 0.7;
        }
           .dashboard {
        flex: 1;
        padding: 20px;
        height:170px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
       
    }

    .card {
        background-color: rgb(2,77,135);
        color:white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
        flex: 0 1 calc(25% - 20px); /* Adjust this value to control the width of the cards */
        box-sizing: border-box;
        height: 120px;
        transition: transform 0.3s ease;
    }
        .navbar{
          background: #fff;
          height: 50px;
          width: 100%;
          box-shadow: 0 3px 5px rgba(0,0,0,0.125);
          display: flex;
          align-items: center;
        }

        .navbar .hamburger{
          font-size: 25px;
          cursor: pointer;
          margin-right: 20px;
          color: rgb(2,77,135);
          display: none;
        }

        .navbar .logo a{
          font-family: 'Trade Winds';
          color: #ffffff;
          font-size: 20px;
        }

        .content{
          padding: 20px;
          display: flex;
          flex-wrap: wrap;
        }


        .content .item{
          background: #fff;
          box-shadow: 2px 2px 4px rgba(0,0,0,0.125), -2px -2px 4px rgba(0,0,0,0.125);
          margin: 10px 5px;
          width: 31%;
          padding: 20px;
        }

        .accordion{
          background: rgb(255, 255, 255);
          padding-left: 20px;
          height: 0px;
          transition: all 0.3s ease;
          overflow: hidden;
        }

        .accordion li a{
          display: block;
          color: #c4dcff;
          padding: 12px 0;
          padding-left: 10px;
        }

        .accordion li:last-child a{
          border-bottom: 0px;
        }

        .accordion li a.active {
            color: #000000;
            text-decoration: none;
        } 

        .accordion li a:hover {
            background: #000000;
            color: #ffffff;
            border-radius: 5px;
            margin-right: 15px;
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .siderbar_menu > li.active .accordion {
            height:auto;
        }

        .siderbar_menu > li.active .arrow{
          transform: rotate(180deg);
          transition: all 0.3s ease;
        }

        @media (max-width: 1024px) {
          .sidebar_inner{
            width: 100%;
            left: -115%;
            transition: all 0.5s ease;
          }
          .main_container{
            width: 100%;
            margin-left: 0;
          }
          .navbar .hamburger,
          .sidebar_inner .close{
            display: block;
          }
          .content .item{
            width: 47%;
          }
          .wrapper.active .sidebar_inner{
          left: 0;
          transition: all 0.5s ease;
        }

        .wrapper.active .sidebar .bg_shadow{
          visibility: visible;
          opacity: 0.7;
        }
        }
        .auto-style21 {
            font-size: x-large;
        }
        .auto-style12{
            width: 190px;
            height: 55px;
            margin-left:537px;
        } 
        @media (max-width: 528px) {
          .content .item{
            width: 100%;
          }
        }
            .auto-style111 {
                font-size: x-large;
            }
            .auto-style222 {
                font-size: large;
            }
        </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <div class="wrapper">
            <div class="sidebar">
                <div class="bg_shadow"></div>
                <div class="sidebar_inner">
                    <div class="close">
                       
                    </div>

                    <div class="profile_info">
                       
                        <div class="profile_data">
                            <p><asp:Label ID="label1" runat="server" text="Admin Dashboard" CssClass="auto-style222" ></asp:Label></p>
                            <br>
                            <span>  <i class="fas fa-user-cog" style="font-size: 2em;"></i> &nbsp;</span>
                            <br />
                            <br />
                            <asp:Label ID="label2" runat="server"  CssClass="auto-style111" ></asp:Label>
                        </div>
                    </div>

                    <ul class="siderbar_menu">
                        <li>
                            <a href="admindash.aspx">
                                <div class="icon"><i class="fas fa-home"></i></div>&nbsp;
                                <div class="title">Dashboard</div>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <div class="icon"><i class="fas fa-sitemap"></i></div>
                                <div class="title">Add Masters</div>
                                <div class="arrow"><i class="fas fa-chevron-down"></i></div>
                            </a>
                            <ul class="accordion">
                                <li><a href="Add_user.aspx" class="active"><i class="fas fa-user-plus"></i>&nbsp Add User </a></li>
                                <li><a href="addcategory.aspx" class="active"><i class="fas fa-list"></i>&nbsp Add Category</a></li>                                
                                <li><a href="user_update.aspx" class="active"><i class="fas fa-user-edit"></i>&nbsp Update User</a></li>
                            </ul>
                        </li>
                        
                    </ul>
                    <div class="logout_btn">
                        <asp:LinkButton ID="btnLogOut" runat="server" CausesValidation="false" OnClick="btnLogOut_Click">
                            <i class="fas fa-sign-out-alt"></i> &nbsp;Logout
                        </asp:LinkButton>
                    </div>
                </div>
            </div>
            <div class="main_container">
                <div class="navbar">
                    <div class="hamburger">
                        
                    </div>
                    
                    &nbsp;<span class="auto-style21"><strong>Maintenance System</strong></span>

                     <img src="images/MHI-1.png" alt="Transparent Image" class="auto-style12">
                </div>
                

                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>

            </div>
        </div>

    </form>
   <script>
       $(document).ready(function () {
           $(".siderbar_menu li").click(function () {
               $(".siderbar_menu li").removeClass("active");
               $(this).addClass("active");
           });

           $(".hamburger").click(function () {
               $(".wrapper").addClass("active");
           });

           $(".close, .bg_shadow").click(function () {
               $(".wrapper").removeClass("active");
           });
       });
   </script>

</body>
</html>
